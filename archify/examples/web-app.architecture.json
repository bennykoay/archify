    },
    {
      "dot": "emerald",
      "title": "Application",
      "items": [
        "FastAPI behind an HTTPS load balancer",
        "Redis read-through cache",
        "Async work drained from SQS by a worker"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "OAuth 2.0 with JWT + PKCE",
        "API + LB isolated in a security group"
