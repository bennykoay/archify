      "to": "api",
      "label": "verify JWT",
      "variant": "security"
    },
    {
      "id": "cdn-to-lb",
      "from": "cdn",
      "to": "lb"
    },
    {
      "id": "static-assets",
      "from": "cdn",
      "to": "s3",
      "label": "static",
      "variant": "dashed"
    },
    {
